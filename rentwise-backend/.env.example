# Database
DATABASE_URL="postgresql://user:password@localhost:5432/rentwise"

# Server
PORT=3000
PUBLIC_BASE_URL="https://your-deployed-url.com"

# Anthropic (extraction engine)
# Leave ANTHROPIC_API_KEY blank and set USE_STUB_EXTRACTION=true to run the
# whole pipeline with a free keyword-based stub instead of a real API call.
ANTHROPIC_API_KEY=""
USE_STUB_EXTRACTION="true"

# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="" # the property's business number, ported or forwarded

# Gmail (shared mailbox, e.g. maintenance@thecompany.com)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI=""
GMAIL_REFRESH_TOKEN=""

# PM software connector (generic REST — AppFolio/Buildium-shaped)
PMS_API_BASE_URL=""
PMS_API_KEY=""

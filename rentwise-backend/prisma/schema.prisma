// RentWise internal data model
// This is the single source of truth every connector (Gmail, Twilio, PMS)
// and every workflow reads from and writes to. Connectors never talk to
// each other directly — they only read/write these tables.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Channel {
  SMS
  EMAIL
}

enum ConversationStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum MessageSender {
  TENANT
  AI
  MANAGER
  SYSTEM
}

enum ActionType {
  SEND_REPLY
  NOTIFY_VENDOR
  CREATE_SERVICE_REQUEST // synced to the PM software
  NOTIFY_MANAGER
}

enum ActionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

enum ActorType {
  AI
  MANAGER
  SYSTEM
}

enum TrustLevel {
  AUTOMATE
  ASK_FIRST
  NEVER
}

model Property {
  id        String   @id @default(cuid())
  name String @unique
  address   String
  pmsId String? @unique // ID of this property inside the connected PM software
  units     Unit[]
  createdAt DateTime @default(now())
}

model Unit {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id])
  unitNumber String
   pmsId String? @unique // ID of this unit inside the connected PM software
  tenants    Tenant[]
}

model Tenant {
  id            String         @id @default(cuid())
  unitId        String
  unit          Unit           @relation(fields: [unitId], references: [id])
  name          String
  email         String?
  phone         String?
  pmsId String? @unique // ID of this tenant inside the connected PM software
  rent          Int
  dueDay        Int
  leaseStart    DateTime
  leaseEnd      DateTime
  conversations Conversation[]
}

model Vendor {
  id       String  @id @default(cuid())
  name     String
  category String // hvac, plumbing, electrical, general
  email    String?
  phone    String?
}

model Conversation {
  id         String             @id @default(cuid())
  tenantId   String
  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  channel    Channel
  category   String // billing, maintenance, leasing, general
  urgent     Boolean            @default(false)
  status     ConversationStatus @default(OPEN)
  messages   Message[]
  actions    Action[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id])
  sender         MessageSender
  body           String
  channel        Channel
  externalId     String? // Twilio SID or Gmail message ID — lets us trace back to the source
  confidence     Int? // AI's confidence in this message's categorization/draft, 0-100
  createdAt      DateTime      @default(now())
}

// Every proposed change to the outside world is an Action.
// Nothing touches Gmail, Twilio, or the PM software except through
// an Action that has passed the approval engine.
model Action {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id])
  type             ActionType
  payload          Json // e.g. { to, body } for SEND_REPLY, { vendorId, unitId, description } for CREATE_SERVICE_REQUEST
  confidence       Int
  requiresApproval Boolean
  forceManual      Boolean      @default(false) // e.g. safety-critical — always true regardless of settings
  forceReason      String?
  status           ActionStatus @default(PENDING_APPROVAL)
  decidedBy        String? // manager user id, or "system" if auto-approved
  decidedAt        DateTime?
  executedAt       DateTime?
  failureReason    String?
  createdAt        DateTime     @default(now())
}

// Append-only. Nothing is ever updated or deleted here.
model AuditLogEntry {
  id          String    @id @default(cuid())
  actorType   ActorType
  actorId     String // "ai-extraction-engine", manager's user id, "twilio-webhook", etc.
  action      String // e.g. "action.created", "action.approved", "action.executed", "message.received"
  entityType  String // "Action", "Message", "Conversation"
  entityId    String
  beforeState Json?
  afterState  Json?
  createdAt   DateTime  @default(now())
}

model AutomationSettings {
  id        String   @id @default("singleton")
  mode      String   @default("confidence") // "autonomous" | "confidence" | "manual" -- fallback used only for an ActionType with no PlaybookRule row yet
  threshold Int      @default(70)
  updatedAt DateTime @updatedAt
}

// One row per ActionType. This is what a manager actually tunes day to
// day -- "auto-send routine replies, but always ask before creating a
// service request or notifying a vendor." Read by engine/approval.ts;
// written by PUT /api/playbook/:actionType. Every change is audit-logged
// the same as everything else, so "who loosened this rule and when" is
// always answerable.
model PlaybookRule {
  id          String     @id @default(cuid())
  actionType  ActionType @unique
  label       String
  description String
  trustLevel  TrustLevel @default(ASK_FIRST)
  updatedAt   DateTime   @updatedAt
}
